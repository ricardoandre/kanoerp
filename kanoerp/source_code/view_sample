// Small hook shared by the image and summary cards: seeds from the sync cache
// when available (so scrolling back re-renders with no placeholder flash),
// otherwise resolves through the batch.
function useLazy(getLoader, peekRef, key) {
  const initial = peekRef() ? peekRef().peek(key) : undefined;
  const sV = useState(initial === undefined ? null : initial); const val = sV[0], setVal = sV[1];
  const sD = useState(initial !== undefined); const done = sD[0], setDone = sD[1];
  useEffect(function () {
