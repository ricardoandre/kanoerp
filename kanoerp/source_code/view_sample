    getLoader().then(function (L) { return L.get(key); }).then(function (v) {
      if (!alive) return; setVal(v || null); setDone(true);
    }, function () { if (alive) { setVal(null); setDone(true); } });
    return function () { alive = false; };
  }, [key]);
  return { value: val, done: done };
}

