      tabs: enums.statusOptions.map(function (o) {
        const c = statusColor(o.value);
        return { key: o.value, label: o.label, color: c, bg: c + '14' };
      }),
      classify: function (r) { return r.status; },
    },

    secondaryFilters: [
      // Multi-select status — separate from the single-select main tab pills.
      // The tab is a quick single-status pick; this is for combining several
      // at once, and is how the "Oldest Update" preset expresses "not
      // done/cancel" while staying visible and editable.
      { key: 'status', label: 'Status', kind: 'select', multi: true, field: 'status', search: true, options: function () { return enums.statusOptions; } },
      { key: 'collection', label: 'Collection', kind: 'select', multi: true, field: 'collection_name', search: true },
      { key: 'designer', label: 'Designer', kind: 'select', multi: true, field: 'designer', search: true, options: function () { return enums.designerOptions; } },
      { key: 'type', label: 'Type', kind: 'select', multi: true, field: 'type', search: true, options: function () { return enums.typeOptions; } },
      // Sewing PIC lives on sample_variant, so the row value is an ARRAY of
      // the distinct PICs across that sample's variants. The engine's default
      // multi comparison can't match an array cell, so this supplies its own
      // match(): "any selected PIC appears on any of this sample's variants".
      {
        key: 'sewing_pic', label: 'Sewing PIC', kind: 'select', multi: true, search: true,
        placeholder: 'Any sewing PIC',
        options: function () { return enums.sewingPicOptions; },
        match: function (row, vals) {
          const pics = row.sewing_pics || [];
          if (!pics.length) return false;
          for (let i = 0; i < vals.length; i++) {
            if (pics.indexOf(vals[i]) !== -1) return true;
          }
          return false;
        },
      },
    ],

    // Default sort = the FIRST entry (the engine does
    // useState(sortOptions[0].key)), so 'created_desc' must stay first.
    sortOptions: [
      { key: 'created_desc', label: 'Newest' },
      { key: 'created_asc',  label: 'Oldest' },
      { key: 'name_asc',     label: 'Name' },
      { key: 'update_asc',   label: 'Oldest Update' },
    ],
    sortComparator: function (key) {
      // Newest: returning null leaves fetchList's own sort untouched.
      if (key === 'created_desc') return null;
      if (key === 'created_asc') {
        return function (a, b) { return new Date(a.created_at || 0) - new Date(b.created_at || 0); };
      }
      // Oldest Update: last logged status change across the sample AND its
      // variants — distinct from created date.
      if (key === 'update_asc') {
        return function (a, b) { return new Date(a.last_status_update || 0) - new Date(b.last_status_update || 0); };
      }
      return function (a, b) { return String(a.name || '').localeCompare(String(b.name || '')); };
    },

    // ── Saved filters — presets combining several conditions at once. They
    // COMBINE with the rest of the popup rather than replacing it: picking one
    // preloads only ITS OWN fields, so narrowing further to one collection
    // afterwards works as expected.
    savedFilters: [
      {
        key: 'oldest_update',
        label: 'Oldest Update',
        // Anything except done/cancel (ideas IS included), sorted by Oldest
        // Update. Expressed through the Status multi-select rather than a
        // match() so the person can SEE and further narrow which statuses are
        // included after picking the preset.
        apply: {
          filters: { status: enums.statusOptions.map(function (o) { return o.value; }).filter(function (v) { return ['cancel', 'done'].indexOf(v) === -1; }) },
          sort: 'update_asc',
        },
      },
      {
        key: 'need_pricing',
        label: 'Need Pricing',
        // Status via apply.filters so the preset visibly populates the Status
        // picker instead of filtering invisibly. target_price and is_new have
        // no secondary-filter field of their own, so they stay in match().
        // The status keys are 'color' and 'done' — CONFIRMED against live
        // data. An earlier guess of 'color_sample' matched nothing and made
        // this preset return an empty list (ASSUMPTION c3, resolved).
        apply: {
          filters: { status: ['color', 'done'] },
        },
        // target_price empty (null/undefined/'' OR a literal 0 — ASSUMPTION
        // c2) AND is_new not EXPLICITLY false (null/undefined still passes).
        match: function (row) {
          return (row.target_price == null || row.target_price === '' || Number(row.target_price) === 0)
            && !isFalseVal(row.is_new);
        },
      },
      /*
      {
        key: 'empty_description',
        label: 'Empty Description',
        // `description` has no secondaryFilters entry, so this is expressed
        // entirely via match(). Treats null/undefined/'' and whitespace-only
        // as empty. STILL DISABLED pending ASSUMPTION (e): the field name is
        // unconfirmed, and if it turns out to be richText the check needs to
        // be stripHtml(row.description).trim() === '' — '<p></p>' would
        // otherwise read as non-empty.
        match: function (row) {
          return row.description == null || String(row.description).trim() === '';
        },
      },*/
    ],

    // Per-card quick actions (mobile swipe panel + desktop hover cluster).
    // Delete is intentionally NOT here — it stays in the detail drawer's "⋯"
    // overflow, which always has its own delete option. primary:false pushes
    // Set Status behind the overflow button, leaving Edit as the only direct
    // icon.
    quickActions: [
      { key: 'edit', icon: '✏️', label: 'Edit', color: '#3b82f6', run: function (r, helpers) { helpers.openEdit(r); } },
      { key: 'set_status', icon: '🏷️', label: 'Set Status', color: '#8b5cf6', primary: false, run: function (r, helpers) { runSetStatus(r, enums, helpers); } },
    ],

    renderCard: renderCard,

    detailTitle: function (r) { return r.name || ('#' + r.id); },
    statusAccent: function (r) { return statusColor(r.status); },
    detailRender: function (row, rk) { return ce(SampleDetailBodyLoader, { sampleId: row.id, refreshKey: rk }); },

    renderNewDrawer: function (api) {
      return ce(NewDrawerLoader, {
        open: api.open, onClose: api.onClose,
        onCreated: function () { api.onClose(); api.helpers.reload(); },
      });
    },
    renderEditDrawer: function (api) {
      return ce(EditDrawerLoader, {
        open: api.open, row: api.row, onClose: api.onClose,
        onSaved: function () {
          api.onClose();
          // An edit can change the image, the variants and the history, so the
          // cached lazy entries for this sample are now stale. Invalidate both
          // before refreshing, or the card re-renders from cache and appears
          // not to have saved.
          const id = api.row && api.row.id;
          if (id != null) {
            if (_imgLoader) _imgLoader.invalidate(id);
            if (_sumLoader) _sumLoader.invalidate(id);
          }
          api.helpers.refresh();
          api.helpers.reloadKeepOpen();
        },
      });
    },

    deleteRow: confirmCascadeDelete,
    deleteTitle: 'Delete sample?',
    deleteLabel: function (row) { return row.name || ('#' + row.id); },

    // bulk action: delete only (per spec). Fetches counts across ALL
    // selected samples up front so the confirmation shows real combined
    // totals, then cascades each one — same cascadeDeleteSample used by
    // the single-row path, so the two can't drift apart.
    bulkActions: [
      { label: '🗑 Delete', bg: '#ef4444', color: '#fff', run: function (ids, helpers) {
          Promise.all(ids.map(function (id) { return fetchSampleDeletionScope(id); }))
            .then(function (scopes) {
              const totals = scopes.reduce(function (acc, c) {
                acc.variants += c.variants; acc.qcChecks += c.qcChecks; acc.materials += c.materials;
                acc.comments += c.comments; acc.history += c.history;
                return acc;
              }, { variants: 0, qcChecks: 0, materials: 0, comments: 0, history: 0 });
              const lines = describeScope(totals);
              Modal.confirm({
                title: 'Delete ' + ids.length + ' sample(s) and everything attached to them?',
                icon: null,
                width: 460,
                content: ce('div', { style: { fontSize: 13, lineHeight: 1.7 } },
                  lines.length
                    ? ce('div', null,
                        ce('div', { style: { marginBottom: 6, color: '#374151' } }, 'Across all selected samples, this will also permanently delete:'),
                        ce('ul', { style: { margin: '0 0 8px', paddingLeft: 20, color: '#374151' } },
                          lines.map(function (l, i) { return ce('li', { key: i }, l); })),
                        ce('div', { style: { color: '#ef4444', fontWeight: 600 } }, 'This cannot be undone.'))
                    : ce('div', { style: { color: '#374151' } }, 'Nothing else is attached to any selected sample. This cannot be undone.')),
                okText: 'Delete everything',
                okButtonProps: { danger: true },
                onOk: function () {
                  return Promise.all(ids.map(function (id) { return cascadeDeleteSample(id); }))
                    .then(function () {
                      message.success('Deleted ' + ids.length + '.');
                      ids.forEach(function (id) {
                        if (_imgLoader) _imgLoader.invalidate(id);
                        if (_sumLoader) _sumLoader.invalidate(id);
                      });
                      helpers.exitSelect();
                      helpers.reload();
                    })
                    .catch(function (e) { message.error('Bulk delete failed: ' + errText(e)); });
                },
              });
            })
            .catch(function (e) { message.error('Failed to check attached records: ' + errText(e)); });
        } },
    ],
  };
  config.DrawerShell = DrawerShellComp;
  return config;
}

// ── root ──
// Enums resolve FIRST — they decide the tab list and every label — then the
// engine, then buildConfig, then a single createListView. Nothing reshapes the
// config after mount: ui_list_engine renders one entry (and its own hooks) per
// main tab, so anything that could change the tab list post-mount is React
// error #310 waiting to happen.
const Root = function () {
  const sLV = useState(null); const LV = sLV[0]; const setLV = sLV[1];
  const sErr = useState(null); const err = sErr[0]; const setErr = sErr[1];
  useEffect(function () {
    Promise.all([
      loadCode('ui_list_engine'),
      loadCode('lib_drawer_shell').catch(function (e) {
        try { console.warn('[view_sample] lib_drawer_shell unavailable: ' + errText(e)); } catch (x) {}
        return null;
      }),
      loadEnumMaps(),
    ]).then(function (r) {
      const M = r[0]; const Shell = r[1]; const enums = r[2];
      if (!M || !M.createListView) throw new Error('ui_list_engine loaded but does not export createListView');
      ENUMS = enums;   // read later by the lazy summary loader
      const config = buildConfig(enums, Shell && Shell.DrawerShell ? Shell.DrawerShell : undefined);
      setLV(function () { return M.createListView(config); });
    }).catch(function (e) { setErr(errText(e)); });
  }, []);
  if (err) return ce('div', { style: { color: '#ef4444', padding: 16, fontSize: 13, lineHeight: 1.6 } }, 'Failed to load the Sample list: ' + err);
  if (!LV) return ce('div', { style: { padding: 40, textAlign: 'center', color: '#9ca3af' } }, 'Loading…');
  return ce(LV);
};

return { Root };
