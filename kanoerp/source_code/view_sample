// -> [variantId, ...] for a sample. Same fk_sample_variant_id-on-
// sample_variant-points-to-sample.id relation already used by
// fetchVariantDerived/loadImagesFor/loadSummariesFor above.
function fetchSampleVariantIds(sampleId) {
  return fetchAllPages('sample_variant', { filter: { fk_sample_variant_id: sampleId }, fields: ['id'] })
    .then(function (rows) { return rows.map(function (r) { return r.id; }); });
}

// Read-only. Counts everything a cascade delete would remove, for display
// in a confirmation dialog — never used to decide what to actually delete
// (see cascadeDeleteSample, which re-fetches independently at delete time).
function fetchSampleDeletionScope(sampleId) {
  return fetchSampleVariantIds(sampleId).then(function (variantIds) {
    return Promise.all([
      variantIds.length ? fetchByIn('sample_qc_check', 'fk_sample_variant_id', variantIds, { fields: ['id'] }) : Promise.resolve([]),
      fetchAllPages('sample_material', { filter: { fk_sample_id: sampleId }, fields: ['id'] }),
      fetchAllPages('sample_comment', { filter: { fk_sample_id: sampleId }, fields: ['id'] }),
      fetchAllPages('history', { filter: { table_name: 'sample', table_id: sampleId }, fields: ['id'] }),
      variantIds.length ? fetchByIn('history', 'table_id', variantIds, { filter: { table_name: 'sample_variant' }, fields: ['id'] }) : Promise.resolve([]),
    ]).then(function (r) {
      return {
        variants: variantIds.length,
        qcChecks: r[0].length,
        materials: r[1].length,
        comments: r[2].length,
        history: r[3].length + r[4].length,
      };
    });
  });
}

// Turns a counts object into ["N variant(s)", "M QC check(s)", ...] for
// display, omitting anything that's zero. Shared by the single-row and
// bulk confirmation dialogs so their wording can't drift apart.
function describeScope(counts) {
  return [
    counts.variants ? counts.variants + ' variant(s)' : null,
    counts.qcChecks ? counts.qcChecks + ' QC check(s)' : null,
    counts.materials ? counts.materials + ' material row(s)' : null,
    counts.comments ? counts.comments + ' comment(s)' : null,
    counts.history ? counts.history + ' history entr' + (counts.history === 1 ? 'y' : 'ies') : null,
  ].filter(Boolean);
}

function destroyByIds(resourceName, ids) {
  if (!ids || !ids.length) return Promise.resolve();
  return ctx.api.resource(resourceName).destroy({ filterByTk: ids });
}

// The actual cascade. Re-derives exactly what to delete right now — does
// NOT accept or reuse a previously-fetched scope, so a delayed confirm
// click still acts on live data. Leaf to root; sample.destroy() is the
// LAST call, so a failure anywhere before it never leaves an orphan.
function cascadeDeleteSample(sampleId) {
  return fetchSampleVariantIds(sampleId).then(function (variantIds) {
    let chain = Promise.resolve();
    if (variantIds.length) {
      chain = chain
        .then(function () { return fetchByIn('sample_qc_check', 'fk_sample_variant_id', variantIds, { fields: ['id'] }); })
        .then(function (rows) { return destroyByIds('sample_qc_check', rows.map(function (r) { return r.id; })); })
        .then(function () { return fetchByIn('history', 'table_id', variantIds, { filter: { table_name: 'sample_variant' }, fields: ['id'] }); })
        .then(function (rows) { return destroyByIds('history', rows.map(function (r) { return r.id; })); })
        .then(function () { return destroyByIds('sample_variant', variantIds); });
    }
    return chain
      .then(function () { return fetchAllPages('sample_material', { filter: { fk_sample_id: sampleId }, fields: ['id'] }); })
      .then(function (rows) { return destroyByIds('sample_material', rows.map(function (r) { return r.id; })); })
      .then(function () { return fetchAllPages('sample_comment', { filter: { fk_sample_id: sampleId }, fields: ['id'] }); })
      .then(function (rows) { return destroyByIds('sample_comment', rows.map(function (r) { return r.id; })); })
      .then(function () { return fetchAllPages('history', { filter: { table_name: 'sample', table_id: sampleId }, fields: ['id'] }); })
      .then(function (rows) { return destroyByIds('history', rows.map(function (r) { return r.id; })); })
      .then(function () { return ctx.api.resource('sample').destroy({ filterByTk: sampleId }); });
  });
}

// The single-row entry point, wired to config.deleteRow. The engine already
// shows its own lightweight confirm (deleteTitle/deleteLabel below) before
// calling this — this is the SECOND, detailed confirmation, with real
// fetched counts, that actually gates the destructive action. Only accepts
// `id` (never assumes the engine passes the full row) and re-fetches the
// sample's own name itself, so it works regardless of exactly what the
// engine's delete-button wiring passes through.
function confirmCascadeDelete(sampleId) {
  return Promise.all([
    ctx.api.resource('sample').get({ filterByTk: sampleId, fields: ['id', 'name'] })
      .then(function (res) { return (res && res.data && res.data.data) || {}; })
      .catch(function () { return {}; }),
    fetchSampleDeletionScope(sampleId),
  ]).then(function (r) {
    const sampleRow = r[0], counts = r[1];
    const lines = describeScope(counts);
    return new Promise(function (resolve, reject) {
      Modal.confirm({
        title: 'Permanently delete "' + (sampleRow.name || ('#' + sampleId)) + '" and everything attached to it?',
        icon: null,
        width: 460,
        content: ce('div', { style: { fontSize: 13, lineHeight: 1.7 } },
          lines.length
            ? ce('div', null,
                ce('div', { style: { marginBottom: 6, color: '#374151' } }, 'This will also permanently delete:'),
                ce('ul', { style: { margin: '0 0 8px', paddingLeft: 20, color: '#374151' } },
                  lines.map(function (l, i) { return ce('li', { key: i }, l); })),
                ce('div', { style: { color: '#ef4444', fontWeight: 600 } }, 'This cannot be undone.'))
            : ce('div', { style: { color: '#374151' } }, 'Nothing else is attached — only the sample record itself will be deleted. This cannot be undone.')),
        okText: 'Delete everything',
        okButtonProps: { danger: true },
        cancelText: 'Cancel',
        onOk: function () { return cascadeDeleteSample(sampleId).then(resolve, reject); },
        onCancel: function () { reject(new Error('Cancelled')); },
      });
    });
  });
}

// Change a sample's status inline from the list, without opening the full Edit
// drawer. Options come from the same enum lib map every other status control
// uses. Modal.confirm's content can't itself be a stateful component, so the
// Select's onChange mutates a closure variable that onOk reads synchronously —
// the standard pattern for a live control inside an imperative modal.
function runSetStatus(row, enums, helpers) {
  let picked = row.status;
  Modal.confirm({
    title: 'Set status — ' + (row.name || ('#' + row.id)),
    icon: null,
    content: ce(Select, {
      style: { width: '100%', marginTop: 8 },
      defaultValue: row.status,
      options: enums.statusOptions,
      onChange: function (v) { picked = v; },
    }),
    okText: 'Save',
    onOk: function () {
      if (picked === row.status) return;
      return ctx.api.resource('sample').update({ filterByTk: row.id, values: { status: picked } })
        .then(function () {
          message.success('Status updated.');
          // The status change also invalidates this sample's cached summary
          // (its history column just gained a row), so drop it before the
          // reload rather than showing a stale column.
          if (_sumLoader) _sumLoader.invalidate(row.id);
          helpers.reload();
        })
        .catch(function (e) { message.error('Update failed: ' + errText(e)); });
    },
  });
}

