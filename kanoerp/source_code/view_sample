// =====================================================
// view_sample — Sample list view. Domain config for ui_list_engine.
// VERSION: v4 (2026-08-07)
//   v4 — cascade delete. Deleting a sample now also deletes every record
//        that has no meaning without it, instead of leaving them behind
//        pointing at a sample id that no longer exists. See CASCADE DELETE
//        section below for the confirmed schema this is built against.
//   v3 — moved OUT of the jblock into this source_code row; per-card lazy
//        loading for BOTH images and summaries; thumbnails; data layer
//        delegated to lib_data_access.
//   v2 — saved filters, sewing PIC filter, oldest-update sort, set-status
//        quick action, created_at field constant. (Changelog items 1-18 of
//        the old jblock header are condensed below — the reasoning that is
//        still load-bearing is kept, the blow-by-blow is not.)
//
// Stored as a `source_code` row named 'view_sample'.
// Loaded by the thin Sample jblock shell; compiled with
//   new Function('React','antd','dayjs','ctx', src)(React, antd, dayjs, ctx).
//
// EXPORTS (contract):
//   Root — the whole view. Takes no props, self-fetches everything.
//
// ── WHY IT MOVED (v3) ──
// view_source_scan can only read the `source_code` collection, so a jblock
// body is invisible to every rule we have — this file's 700 lines were
// unscanned and drifting. The jblock is now a ~50-line shell that calls
// loadCode('view_sample') and renders Mod.Root. Paste the shell into the
// EXISTING block; never delete-and-recreate (a new UID breaks any filter
// controller referencing it).
//
// ── LAZY LOADING (v3) — the actual perf change ──
// The old version fetched, for EVERY sample in the table, on every mount:
//   • all sample_variant rows with `appends: ['image']`
//   • all sample rows with `appends: ['reference_images']`
//   • variants + materials + comments + history (4 more queries)
// …to render ~15 cards. `fetchImages()` couldn't even be scoped, because the
// engine calls it with ZERO arguments; `fetchSummaries(rows)` gets `rows`,
// but that's every loaded row, not the visible page.
//
// Both are now per-card and batched through lib_lazy_batch: a card asks for
// its own sample id, the asks are collected for ~40 ms, and ONE request set
// goes out for the ids actually on screen. Paging, searching and filtering
// come free — a card that never mounts never asks — and results are cached,
// so scrolling back re-renders with no request. config.fetchImages and
// config.fetchSummaries are gone; the card renders SampleCardBody, which
// fetches its own two pieces.
//
// EAGER EXCEPTION — deliberately NOT made lazy:
//   fetchList() and fetchVariantDerived() stay eager, because the engine runs
//   secondaryFilters' match() and sortComparator across EVERY row including
//   ones never rendered. `sewing_pics` (the Sewing PIC filter) and
//   `last_status_update` (the Oldest Update sort) must therefore be on the row
//   itself. Making those lazy would silently break filtering and sorting for
//   off-screen rows, which is far worse than the request they cost.
//
// ── THUMBNAILS (v3) ──
// Card images now request /storage/uploads/thumb/<same filename>, generated by
// make-thumbs.sh (measured 562 KB -> 26 KB). Pure URL rewrite, with an onError
// fallback to the original, so a gap in the thumbnail cache shows a slightly
// heavy image rather than a broken one. Detail-view images are untouched —
// those are per-record already and want full resolution.
//
// ── IMAGE UPLOADS ──
// This view does not upload anything. Sample images are uploaded by
// ui_sample_add / ui_sample_edit, and inline images by lib_rich_text_editor
// (which resizes to 1600 px / JPEG 85 as of 2026-08-06). If a sample image
// still arrives full-size, the upload call in ui_sample_add / ui_sample_edit
// is the place to route through lib_image_resize — those two are also still
// on ctx.sql per view_source_scan, so they want converting in the same pass.
//
// ── DOMAIN NOTES worth keeping ──
//  • Enums: nothing is hardcoded. Every value+label pair for a single-select
//    comes from lib_enum_labels. sample.status and sample_variant.status are
//    DIFFERENT enums with different value sets, hence two color tables.
//  • Comments are richText (HTML). stripHtml() renders them as plain text in
//    the card — never raw HTML inside a 2-line clamp.
//  • Variant chips are a color dot + muted text, deliberately not a bold
//    pill: they must read as subordinate to the sample's own status badge.
//  • Sewing PIC lives on sample_variant, so a sample's value is a SET. The
//    row carries an array and the filter supplies its own match(), because
//    the engine's default multi comparison (`vals.indexOf(cell) !== -1`)
//    can't match an array cell.
//  • Oldest Update = max history.create_date across the sample's own history
//    AND its variants' history (a variant moving sewing -> qc counts as the
//    sample being worked on), falling back to created_at when there is no
//    history yet.
//  • Saved filters combine with the popup rather than replacing it, and
//    express their status conditions through apply.filters so the picker
//    stays visible and editable after applying a preset.
//  • Delete is NOT a per-card quick action — it stays in the detail drawer's
//    overflow, where deleting is a considered act rather than a swipe.
//    Deleting a sample now cascades — see CASCADE DELETE below.
//
// ── CASCADE DELETE (v4) ──
// Deleting a sample used to be a single `sample.destroy()` — every
// fk_sample_id / fk_sample_variant_id row pointing at it (variants, QC
// checks, materials, comments, history) was left behind referencing an id
// that no longer existed. None of those are real NocoBase relations with a
// DB-level constraint; they're plain integer fk_* columns the framework
// has no awareness of, so nothing cascaded automatically.
//
// Schema actually confirmed (2026-08-07, live schema dump) for what a
// sample "owns" and cascades to on delete, leaf to root:
//   sample_qc_check      fk_sample_variant_id -> sample_variant.id
//   history               table_name='sample_variant', table_id -> sample_variant.id
//   sample_variant        fk_sample_variant_id -> sample.id   (confusing name;
//                          this is the FK to the PARENT sample, matches the
//                          usage already established elsewhere in this file)
//   sample_material        fk_sample_id -> sample.id
//   sample_comment          fk_sample_id -> sample.id
//   history               table_name='sample', table_id -> sample.id
//   sample                 (deleted last)
//
// Deliberately EXCLUDED from the cascade:
//   • sample.reference_images and sample_variant.image / .qc_measurements
//     are real belongsToMany relations through a junction table — NocoBase
//     cleans up the junction rows itself when the owning record is
//     destroyed, same as any belongsToMany. Manually touching them here
//     would be redundant at best.
//   • sample_qc_checklist is a shared TEMPLATE table (the list of possible
//     checklist items), not data owned by any one sample — deleting a
//     sample must never touch it.
//
// Order matters for correctness of the confirmation dialog's counts, not
// for the DB (no real constraints exist to violate), but the cascade still
// goes leaf-to-root with the sample destroyed LAST: if any step before the
// final sample.destroy() throws, the chain stops there. Worst case is some
// already-empty children plus an intact, undeleted sample — retryable, and
// never an orphaned child with no host, which is the exact bug this
// replaces.
//
// The confirmation dialog (confirmCascadeDelete / the bulk delete action)
// fetches real counts before showing anything, so the person sees exactly
// what will be destroyed rather than a generic warning. cascadeDeleteSample
// itself independently RE-FETCHES ids at delete time rather than reusing
// those counts — the dialog's numbers are only ever a preview; if anything
// changed between opening it and clicking confirm, the actual deletion
// still acts on whatever's there now, not a stale snapshot.

//
// ── ASSUMPTIONS (unchanged from v2 — verify if something looks wrong) ──
//   a.  lib_enum_labels' enumLabelMap() works for ('sample_variant','status')
//       and ('sample_variant', SEWING_PIC_FIELD), same call shape as the
//       confirmed ('sample','designer') site.
//   a2. history rows for a variant use table_name === 'sample_variant' with
//       table_id equal to the VARIANT's id, not the parent sample's.
//   b.  sample_comment exposes createdBy, history exposes user; both return
//       { nickname, username, ... } when appended.
//   c2. "Need Pricing" treats a literal 0 target_price as empty.
//   c3. RESOLVED — the status keys are 'color' and 'done'. An earlier guess of
//       'color_sample' matched nothing and made the preset return an empty
//       list. Confirmed against live data.
//   d.  is_new may be boolean or stringified; isTrue/isFalseVal handle both.
//   e.  sample.description — the "Empty Description" preset is still commented
//       out pending confirmation of the field name and whether it's richText.
//   f.  SEWING_PIC_FIELD is the literal column name on sample_variant. If the
//       Sewing PIC picker comes up EMPTY, that constant is the first suspect.
//   g.  CREATED_AT_FIELD is confirmed for `sample` against the live DB and
//       ASSUMED for `sample_comment`. If comment dates render "—" while
//       sample dates are fine, that assumption is what broke — NocoBase can be
//       underscored per-collection.
// =====================================================
const { useState, useEffect } = React;
const { Modal, Spin, message, Select } = antd;
const ce = React.createElement;

// ── shared code loader — caches the PROMISE, throws on an empty row, evicts
// failures. (The old jblock cached the RESOLVED module and used `|| ''`, which
// compiled a missing row into `undefined` and cached that forever.)
const _codeCache = {};
function loadCode(name) {
  if (_codeCache[name]) return _codeCache[name];
  _codeCache[name] = ctx.api.resource('source_code').list({
    filter: { name: name },
    fields: ['code'],
    pageSize: 1,
  }).then(function (res) {
    const rows = (res && res.data && res.data.data) || [];
    const src = rows[0] && rows[0].code;   // deliberately not `|| ''`
    if (!src) throw new Error('source_code row missing or empty: "' + name + '"');
    const mod = new Function('React', 'antd', 'dayjs', 'ctx', src)(React, antd, dayjs, ctx);
    if (!mod) throw new Error('source_code row "' + name + '" compiled to nothing — missing its final return?');
    return mod;
  }).catch(function (e) { delete _codeCache[name]; throw e; });
  return _codeCache[name];
}

function errText(e) {
  if (!e) return 'unknown error';
  const body = e.response && e.response.data;
  const apiMsg = body && body.errors && body.errors[0] && body.errors[0].message;
  const status = e.response && e.response.status ? '[HTTP ' + e.response.status + '] ' : '';
  return status + String(apiMsg || e.message || e);
}

// ── data helpers: delegate to the shared lib_data_access (v3; these used to
// be local copies of fetchAllPages / chunk / fetchByIn). Lazy, so callers
// never need to care whether the lib has loaded yet.
let _dbPromise = null;
function db() {
  if (!_dbPromise) _dbPromise = loadCode('lib_data_access');
  return _dbPromise;
}
function fetchAllPages(resourceName, params) {
  return db().then(function (DB) { return DB.fetchAllPages(resourceName, params); });
}
function fetchByIn(resourceName, field, values, params) {
  return db().then(function (DB) { return DB.fetchByIn(resourceName, field, values, params); });
}

// ── field-name constants (see ASSUMPTIONS f and g) ──
// Single point of change each: SEWING_PIC_FIELD feeds fetchVariantDerived's
// `fields` list, the row read inside it, and the enumLabelMap lookup.
const SEWING_PIC_FIELD = 'sewing_pic';
// This instance uses underscored naming, so it is `created_at`, NOT
// `createdAt`. Feeds fetchList's `fields` + `sort`, the comment fetch, and
// readCreated().
const CREATED_AT_FIELD = 'created_at';

// Tolerant read: prefers the underscored key, falls back to camelCase so a
// mixed-convention collection still renders a date instead of "—". The
// fallback covers READS ONLY — `fields`/`sort` params go out using
// CREATED_AT_FIELD verbatim, so if the API ignores an unknown field name the
// symptom is every card showing "—" and the Newest/Oldest sorts doing nothing.
// That symptom means CREATED_AT_FIELD is wrong for that collection.
function readCreated(r) {
  if (!r) return null;
  const v = r[CREATED_AT_FIELD];
  return (v == null || v === '') ? r.createdAt : v;
}

// ── enum lib loader (module-level cache; loaded once) ──
let _enumPromise = null;
function loadEnumMaps() {
  if (_enumPromise) return _enumPromise;
  _enumPromise = loadCode('lib_enum_labels').then(function (Lib) {
    function toOptions(map) {
      return Object.keys(map || {}).map(function (k) { return { value: k, label: map[k] }; });
    }
    const statusMap = Lib.enumLabelMap('sample', 'status') || {};
    const designerMap = Lib.enumLabelMap('sample', 'designer') || {};
    const typeMap = Lib.enumLabelMap('sample', 'type') || {};
    // sample_variant.status is its own select field, separate from
    // sample.status — see ASSUMPTION (a).
    const variantStatusMap = Lib.enumLabelMap('sample_variant', 'status') || {};
    const sewingPicMap = Lib.enumLabelMap('sample_variant', SEWING_PIC_FIELD) || {};
    return {
      statusMap: statusMap,
      designerMap: designerMap,
      typeMap: typeMap,
      variantStatusMap: variantStatusMap,
      sewingPicMap: sewingPicMap,
      statusOptions: toOptions(statusMap),
      designerOptions: toOptions(designerMap),
      typeOptions: toOptions(typeMap),
      sewingPicOptions: toOptions(sewingPicMap),
    };
  });
  return _enumPromise;
}

// Set once by Root before the config is built, so the lazy summary loader
// (which runs long after) can label variant statuses without threading enums
// through every card.
let ENUMS = null;

// ── status colors (inline domain "flavor" only — labels always come from the enum lib) ──
const STATUS_COLOR = {
  ideas: '#f97316',
  pola: '#f97316',
  first_sample: '#d97706',
  pricing: '#84cc16',
  color: '#84cc16',
  color_sample: '#84cc16',
  done: '#22c55e',
  cancel: '#ef4444',
};
function statusColor(v) { return STATUS_COLOR[String(v || '').toLowerCase()] || '#9ca3af'; }

// sample_variant.status palette — a different value set than sample.status.
const VARIANT_STATUS_COLOR = {
  pending: '#94a3b8',
  sewing: '#f97316',
  qc: '#84cc16',
  approval: '#8b5cf6',
  minor_revision: '#ef4444',
  done: '#22c55e',
  cancel: '#ef4444',
};
function variantStatusColor(v) { return VARIANT_STATUS_COLOR[String(v || '').toLowerCase()] || '#9ca3af'; }

// ── helpers ──
function fmtDateTime(d) { if (!d) return '—'; const p = dayjs(d); return p.isValid() ? p.format('DD MMM YYYY, HH:mm') : '—'; }
// Shown next to the Oldest Update sort so the ordering is visibly justified on
// the card, not just a silent sort key.
function daysAgoLabel(d) {
  if (!d) return null;
  const p = dayjs(d);
  if (!p.isValid()) return null;
  const days = Math.max(0, dayjs().diff(p, 'day'));
  if (days === 0) return 'Updated today';
  if (days === 1) return 'Updated 1 day ago';
  return 'Updated ' + days + ' days ago';
}
function isTrue(v) { return v === true || v === 1 || String(v).toLowerCase() === 'true'; }
// Inverse of isTrue, for excluding rows where a checkbox is EXPLICITLY false —
// null/undefined (never set) is intentionally NOT "false" here.
function isFalseVal(v) { return v === false || v === 0 || String(v).toLowerCase() === 'false'; }
function personName(u) { return (u && (u.nickname || u.username)) || 'Unknown'; }

// richText comment fields store HTML — strip it to plain text for the compact
// card preview (never render raw HTML in a fixed-height clamp).
function stripHtml(html) {
  if (!html) return '';
  return String(html)
    .replace(/<style[\s\S]*?<\/style>/gi, '')
    .replace(/<script[\s\S]*?<\/script>/gi, '')
    .replace(/<\/(p|div|li|h[1-6])>/gi, '\n')
    .replace(/<br\s*\/?>/gi, '\n')
    .replace(/<[^>]+>/g, '')
    .replace(/&nbsp;/g, ' ')
    .replace(/&amp;/g, '&')
    .replace(/&lt;/g, '<')
    .replace(/&gt;/g, '>')
    .replace(/&quot;/g, '"')
    .replace(/&#39;/g, "'")
    .replace(/\n{2,}/g, '\n')
    .trim();
}

// ── collections (small table, used for filters + new/edit drawer props) ──
let _collectionsPromise = null;
function fetchAllCollections() {
  if (_collectionsPromise) return _collectionsPromise;
  _collectionsPromise = fetchAllPages('collection', {
    fields: ['id', 'name', 'target_photoshoot'],
    sort: ['name'],
  }).catch(function (e) {
    _collectionsPromise = null; // evict so a later call retries
    try { console.warn('[view_sample] collections unavailable: ' + errText(e)); } catch (x) {}
    return [];
  });
  return _collectionsPromise;
}

// ── thumbnails ──
// The card shows an 84px crop but the stored image is the full-size original.
// A thumbnail of the same file lives beside it under /storage/uploads/thumb/,
// generated by make-thumbs.sh. Pure URL rewrite; onImgError falls back to the
// original one time, so it cannot loop.
const THUMB_SEG = '/storage/uploads/thumb/';
const FULL_SEG = '/storage/uploads/';
function thumbUrl(u) {
  if (!u || u.indexOf(THUMB_SEG) !== -1) return u;
  if (u.indexOf(FULL_SEG) === -1) return u;   // not a local upload (S3 etc.)
  return u.replace(FULL_SEG, THUMB_SEG);
}
function fullUrl(u) {
  if (!u || u.indexOf(THUMB_SEG) === -1) return u;
  return u.replace(THUMB_SEG, FULL_SEG);
}
function onImgError(e) {
  const el = e && e.target;
  if (!el) return;
  const cur = el.getAttribute('src') || '';
  const orig = fullUrl(cur);
  if (orig && orig !== cur) el.src = orig;
}
function buildImgUrl(filename, url) {
  if (url) return url;
  if (filename) return FULL_SEG + filename;
  return '';
}

// ── data layer: eager (needed by filters + sort — see EAGER EXCEPTION) ──
//
// Returns { lastUpdate, sewingPics }:
//   lastUpdate  { [sampleId]: epochMillis }  — max history.create_date across
//     the sample's own history AND its variants' history. See ASSUMPTION (a2).
//     `history.create_date` is NOT affected by the created_at rename — it's a
//     distinct field name, not a convention variant.
//   sewingPics  { [sampleId]: [picValue, ...] } — distinct non-null PICs across
//     that sample's variants. Samples with no PIC anywhere get an empty array
//     and never match the Sewing PIC filter (there is no "No PIC" option).
function fetchVariantDerived(sampleIds) {
  const empty = { lastUpdate: {}, sewingPics: {} };
  if (!sampleIds.length) return Promise.resolve(empty);
  return fetchByIn('sample_variant', 'fk_sample_variant_id', sampleIds, { fields: ['id', 'fk_sample_variant_id', SEWING_PIC_FIELD] })
    .then(function (variantRows) {
      const sampleIdByVariantId = {};
      const picsBySample = {};
      variantRows.forEach(function (v) {
        const sid = String(v.fk_sample_variant_id);
        sampleIdByVariantId[String(v.id)] = sid;
        const pic = v[SEWING_PIC_FIELD];
        if (pic == null || pic === '') return;
        if (!picsBySample[sid]) picsBySample[sid] = [];
        if (picsBySample[sid].indexOf(pic) === -1) picsBySample[sid].push(pic);
      });
      const variantIds = variantRows.map(function (v) { return v.id; });

      return Promise.all([
        fetchByIn('history', 'table_id', sampleIds, { filter: { table_name: 'sample' }, fields: ['table_id', 'create_date'] }),
        fetchByIn('history', 'table_id', variantIds, { filter: { table_name: 'sample_variant' }, fields: ['table_id', 'create_date'] }),
      ]).then(function (r) {
        const sampleHistory = r[0], variantHistory = r[1];
        const latest = {};
        function bump(sampleId, date) {
          if (!sampleId || !date) return;
          const k = String(sampleId);
          const t = new Date(date).getTime();
          if (!latest[k] || t > latest[k]) latest[k] = t;
        }
        sampleHistory.forEach(function (h) { bump(h.table_id, h.create_date); });
        variantHistory.forEach(function (h) { bump(sampleIdByVariantId[String(h.table_id)], h.create_date); });
        return { lastUpdate: latest, sewingPics: picsBySample };
      });
    }).catch(function (e) {
      // DELIBERATE DEGRADE: the Sewing PIC filter matches nothing and Oldest
      // Update falls back to created_at ordering — the list still works.
      try { console.warn('[view_sample] variant-derived data unavailable: ' + errText(e)); } catch (x) {}
      return empty;
    });
}

function fetchList(enums) {
  return fetchAllPages('sample', {
    fields: ['id', 'name', 'status', 'type', 'designer', 'is_new', 'target_price', 'fk_collection_id', CREATED_AT_FIELD, 'description'],
    sort: ['-' + CREATED_AT_FIELD],
  }).then(function (rows) {
    const collectionIds = rows.map(function (r) { return r.fk_collection_id; }).filter(Boolean);
    const sampleIds = rows.map(function (r) { return r.id; });
    return Promise.all([
      fetchByIn('collection', 'id', collectionIds, { fields: ['id', 'name'] }),
      fetchVariantDerived(sampleIds),
    ]).then(function (r) {
      const collRows = r[0], derived = r[1];
      const lastUpdateMap = derived.lastUpdate || {};
      const sewingPicsMap = derived.sewingPics || {};
      const collById = {};
      collRows.forEach(function (c) { collById[String(c.id)] = c; });
      return rows.map(function (r) {
        const coll = collById[String(r.fk_collection_id)] || {};
        const lastUpdateMs = lastUpdateMap[String(r.id)];
        const createdAtVal = readCreated(r);
        return {
          id: r.id,
          name: r.name,
          status: r.status,
          status_label: (enums.statusMap && enums.statusMap[r.status]) || r.status || '—',
          type: r.type,
          type_label: (enums.typeMap && enums.typeMap[r.type]) || r.type || '—',
          designer: r.designer,
          designer_label: (enums.designerMap && enums.designerMap[r.designer]) || r.designer || '—',
          is_new: r.is_new,
          target_price: r.target_price,
          description: r.description,   // for the (currently disabled) Empty Description preset
          // Row key stays `created_at` regardless of the source field name, so
          // sortComparator and the card never have to care which convention
          // the collection uses.
          created_at: createdAtVal,
          // Falls back to the created timestamp when a sample has no history
          // yet (brand new, never had a logged status change).
          last_status_update: lastUpdateMs ? new Date(lastUpdateMs).toISOString() : createdAtVal,
          // ARRAY of distinct sewing PICs across this sample's variants.
          sewing_pics: sewingPicsMap[String(r.id)] || [],
          collection_id: r.fk_collection_id,
          collection_name: coll.name,
        };
      });
    });
  });
}

// ── data layer: LAZY, per card, batched by lib_lazy_batch ──
// Each card asks for its own sample id; asks are collected for ~40 ms and
// issued as ONE request set for the ids actually on screen.
function lazyLib() { return loadCode('lib_lazy_batch'); }   // already promise-cached

// --- images ---
// Priority matches the photo dashboard's CollectionPreviewPage: the first
// non-cancelled variant image wins; the sample's own reference image is the
// fallback.
function loadImagesFor(sampleIds) {
  return Promise.all([
    fetchByIn('sample_variant', 'fk_sample_variant_id', sampleIds, {
      fields: ['id', 'fk_sample_variant_id', 'status'],
      appends: ['image'],
      filter: { status: { $ne: 'cancel' } },
      sort: ['id'],
    }),
    fetchByIn('sample', 'id', sampleIds, { fields: ['id'], appends: ['reference_images'] }),
  ]).then(function (r) {
    const variantRows = r[0], sampleRows = r[1];
    const out = {};

    sampleRows.forEach(function (s) {
      const imgs = Array.isArray(s.reference_images) ? s.reference_images : [];
      const first = imgs[0];
      if (first) out[String(s.id)] = thumbUrl(buildImgUrl(first.filename, first.url));
    });

    const bySample = {};
    variantRows.forEach(function (v) {
      const sid = String(v.fk_sample_variant_id);
      if (!bySample[sid]) bySample[sid] = [];
      bySample[sid].push(v);
    });
    Object.keys(bySample).forEach(function (sid) {
      const sorted = bySample[sid].slice().sort(function (a, b) { return (a.id || 0) - (b.id || 0); });
      for (let i = 0; i < sorted.length; i++) {
        const imgs = Array.isArray(sorted[i].image) ? sorted[i].image : [];
        if (imgs.length) { out[sid] = thumbUrl(buildImgUrl(imgs[0].filename, imgs[0].url)); break; }
      }
    });

    return out;
  });
}

// --- summaries (variants / materials / comments / history) ---
// Every requested id gets an entry, so a sample with no variants renders
// "No variants" rather than an indefinite placeholder.
function loadSummariesFor(sampleIds) {
  const enums = ENUMS || {};
  return Promise.all([
    fetchByIn('sample_variant', 'fk_sample_variant_id', sampleIds, { fields: ['id', 'fk_sample_variant_id', 'status', 'fk_fabric_code'] }),
    fetchByIn('sample_material', 'fk_sample_id', sampleIds, { fields: ['id', 'fk_sample_id', 'fk_raw_material_code'] }),
    // CREATED_AT_FIELD here too — see ASSUMPTION (g).
    fetchByIn('sample_comment', 'fk_sample_id', sampleIds, { fields: ['id', 'fk_sample_id', 'comment', CREATED_AT_FIELD], appends: ['createdBy'] }),
    // ASSUMPTION: table_name === 'sample' for this collection's log rows.
    fetchByIn('history', 'table_id', sampleIds, { filter: { table_name: 'sample' }, fields: ['id', 'table_id', 'message', 'category', 'status', 'create_date'], appends: ['user'] }),
  ]).then(function (r) {
    const variantRows = r[0], smRows = r[1], commentRows = r[2], historyRows = r[3];
    const map = {};
    sampleIds.forEach(function (id) { map[String(id)] = { variants: [], materials: [], comments: [], history: [] }; });
    function ensure(id) {
      const k = String(id);
      if (!map[k]) map[k] = { variants: [], materials: [], comments: [], history: [] };
      return map[k];
    }

    variantRows.forEach(function (v) {
      ensure(v.fk_sample_variant_id).variants.push({
        status: v.status,
        status_label: (enums.variantStatusMap && enums.variantStatusMap[v.status]) || v.status || '—',
        fabric: v.fk_fabric_code || '—',
      });
    });
    smRows.forEach(function (m) {
      ensure(m.fk_sample_id).materials.push({ code: m.fk_raw_material_code || '—' });
    });
    commentRows.forEach(function (c) {
      ensure(c.fk_sample_id).comments.push({ text: stripHtml(c.comment), who: personName(c.createdBy), date: readCreated(c) });
    });
    historyRows.forEach(function (h) {
      ensure(h.table_id).history.push({ message: h.message || '', category: h.category, status: h.status || null, who: personName(h.user), date: h.create_date });
    });

    // Last 2 only, newest first — sorted client-side, since fetchByIn's
    // per-batch sort doesn't guarantee a global order across batches.
    Object.keys(map).forEach(function (k) {
      map[k].comments.sort(function (a, b) { return new Date(b.date || 0) - new Date(a.date || 0); });
      map[k].comments = map[k].comments.slice(0, 2);
      map[k].history.sort(function (a, b) { return new Date(b.date || 0) - new Date(a.date || 0); });
      map[k].history = map[k].history.slice(0, 2);
    });
    return map;
  });
}

// Both loaders cache the PROMISE, not the built loader — several cards
// mounting in one render pass would otherwise each start their own build. The
// plain refs alongside are only ever READ synchronously by peek().
let _imgLoaderP = null, _imgLoader = null;
function imageLoader() {
  if (_imgLoaderP) return _imgLoaderP;
  _imgLoaderP = lazyLib().then(function (LB) {
    _imgLoader = LB.createBatchLoader({ load: loadImagesFor });
    return _imgLoader;
  }).catch(function (e) { _imgLoaderP = null; throw e; });
  return _imgLoaderP;
}
let _sumLoaderP = null, _sumLoader = null;
function summaryLoader() {
  if (_sumLoaderP) return _sumLoaderP;
