var MasonryGrid = function(props) {
  var samples  = props.samples;
  var onOpen   = props.onOpen;
  var maxCols  = props.maxCols || 4;

  // 'pricing' removed — no longer used.
  var STATUS_SORT = ['done','color','first_sample','pola','ideas'];
  var sorted = samples.slice().sort(function(a, b) {
    var ai = STATUS_SORT.indexOf(String(a.status || '').toLowerCase());
