// Variant status mapping updated:
//   pending, sewing, minor_revision, qc, approval -> inprogress
//   done -> approved
var VARIANT_INPROGRESS = ['pending','sewing','minor_revision','qc','approval'];
var VARIANT_APPROVED   = ['done'];
var VARIANT_CANCEL     = ['cancel'];

function getStatus(val) {
  return STATUS_META[String(val || '').toLowerCase()] || { label: val || '—', color: '#9ca3af', group: 'other' };
}

function classifySample(status) {
  var s = String(status || '').toLowerCase();
  if (SAMPLE_INPROGRESS.indexOf(s) !== -1) return 'inprogress';
  if (SAMPLE_APPROVED.indexOf(s) !== -1)   return 'approved';
  if (SAMPLE_CANCEL.indexOf(s) !== -1)     return 'cancel';
  return 'other';
}

function classifyVariant(status) {
  var s = String(status || '').toLowerCase();
  if (VARIANT_INPROGRESS.indexOf(s) !== -1) return 'inprogress';
  if (VARIANT_APPROVED.indexOf(s) !== -1)   return 'approved';
  if (VARIANT_CANCEL.indexOf(s) !== -1)     return 'cancel';
  return 'other';
}

function classifyProgress(sample, variantStatuses) {
  var status = String((sample && sample.status) || '').toLowerCase();
  if (status === 'ideas') return 'ideas';
  if (status === 'pola') return 'pola';
  if (status === 'first_sample') {
  var vs = (variantStatuses || []).map(function(s) { return String(s || '').toLowerCase(); });
    if (vs.indexOf('minor_revision') !== -1) return 'revision';
    if (vs.indexOf('qc') !== -1) return 'qc';
    if (vs.indexOf('approval') !== -1) return 'approval';
    // sample marked first_sample but sewing hasn't started yet on any
    // variant (still pending) — bucketed between Pola and First Sample.
    // Checked last among the first_sample sub-statuses so a variant that's
    // already progressed past pending (sewing/qc/approval) still wins.
    if (vs.indexOf('pending') !== -1) return 'pending';
    return 'first_sample';
  }
  if (status === 'color' || status === 'done') return 'approved';
  return null;
}

function runSql(uid, sql) {
  var s = ctx.sql;
  if (!s) return Promise.resolve([]);
  return s.save({ uid: uid, sql: sql, dataSourceKey: 'main' })
    .catch(function(){})
    .then(function() { return s.runById(uid, { type: 'selectRows', dataSourceKey: 'main' }); })
    .then(function(r) { return r || []; })
    .catch(function() { return []; });
}

function buildImgUrl(filename, url) {
  if (url) return url;
  if (filename) return window.location.origin + '/storage/uploads/' + filename;
  return '';
}

function fetchVariantImages(sampleIds) {
  if (!sampleIds || !sampleIds.length) return Promise.resolve([]);
  var CHUNK = 150;
  var chunks = [];
  for (var i = 0; i < sampleIds.length; i += CHUNK) chunks.push(sampleIds.slice(i, i + CHUNK));

  return Promise.all(chunks.map(function (ids) {
    return ctx.api.resource('sample_variant').list({
      appends: ['image'],
      filter: { fk_sample_variant_id: { $in: ids }, status: { $ne: 'cancel' } },
      fields: ['id', 'fk_sample_variant_id', 'status'],
      sort: ['id'],
      pageSize: 400,
    }).then(function (res) {
      return (res && res.data && res.data.data) || [];
    });
  })).then(function (results) {
    return [].concat.apply([], results);
  });
}

function formatPrice(v) {
  var n = Number(v);
  if (!n) return '';
  return 'Rp' + n.toLocaleString('id-ID');
}

// escape a search term for embedding inside a single-quoted SQL literal,
// then wrap it in a case-insensitive LIKE clause against `col`.
function likeClause(col, term) {
  var esc = String(term).replace(/'/g, "''");
  return "LOWER(" + col + ") LIKE LOWER('%" + esc + "%')";
}

// ─────────────────────────────────────────────────────────────
// GLOBAL SEARCH HELPERS (used by the top-level, always-visible search bar)
//
// sample_variant.fabric / fabric2 are `belongsTo` relations to
// material_details — not plain text columns — so raw SQL must reference the
// underlying foreign-key columns fk_fabric_code / fk_fabric_code2 instead.
// Searches across every (non-photoshoot) collection, not just the one
// currently open in the preview page.
// ─────────────────────────────────────────────────────────────
function searchSampleIds(query) {
  return runSql('global_search_ids_' + Date.now(),
    "SELECT DISTINCT sample.id AS id FROM sample, collection " +
    "WHERE sample.fk_collection_id = collection.id " +
    "AND (collection.photoshoot IS NULL OR collection.photoshoot = 0 OR collection.photoshoot = FALSE) " +
    "AND (" + likeClause('sample.name', query) + " OR " + likeClause('sample.description', query) + " " +
    "OR sample.id IN (" +
      "SELECT sample_variant.fk_sample_variant_id FROM sample_variant " +
      "WHERE (" + likeClause('sample_variant.fk_fabric_code', query) + " OR " + likeClause('sample_variant.fk_fabric_code2', query) + ")" +
    "))"
  );
}

function fetchSampleCards(sampleIds) {
  if (!sampleIds || !sampleIds.length) return Promise.resolve([]);
  var idList = sampleIds.join(',');
  var baseUid = 'global_search_base_' + Date.now();
  var imgUid  = 'global_search_img_' + Date.now();

  return Promise.all([
    runSql(baseUid,
      "SELECT sample.id AS id, sample.name AS name, sample.status AS status, " +
      "sample.type AS type, sample.designer AS designer, sample.is_new AS is_new, " +
      "sample.target_price AS target_price, collection.name AS collection_name, " +
      "sample.fk_collection_id AS collection_id " +
      "FROM sample, collection " +
      "WHERE sample.fk_collection_id = collection.id " +
      "AND sample.id IN (" + idList + ")"
    ),
    runSql(imgUid,
      "SELECT t_wda3bnmr9c9.f_57nmxuosclw AS sample_id, " +
      "attachments.url AS img_url, attachments.filename AS img_filename " +
      "FROM t_wda3bnmr9c9, attachments " +
      "WHERE attachments.id = t_wda3bnmr9c9.f_3icqdx05qdd " +
      "AND t_wda3bnmr9c9.f_57nmxuosclw IN (" + idList + ") " +
      "ORDER BY attachments.id ASC"
    ),
    fetchVariantImages(sampleIds),
  ]).then(function(results) {
    var sampleRows = results[0];
    var imgRows = results[1];
    var variantImgRows = results[2];

    var imgMap = {};
    imgRows.forEach(function(r) {
      var sid = String(r.sample_id);
      if (!imgMap[sid]) imgMap[sid] = buildImgUrl(r.img_filename, r.img_url);
    });

    var variantImgMap = {};
    variantImgRows.forEach(function(row) {
      var sid = String(row.fk_sample_variant_id);
      var imgs = Array.isArray(row.image) ? row.image.slice() : [];
      if (!imgs.length) return;
      imgs.sort(function(a, b) { return (a.id || 0) - (b.id || 0); });
      if (!variantImgMap[sid]) variantImgMap[sid] = [];
      imgs.forEach(function(img) {
        var url = buildImgUrl(img.filename, img.url);
        if (url) variantImgMap[sid].push(url);
      });
    });

    return sampleRows.map(function(r) {
      var vImgs = variantImgMap[String(r.id)] || [];
      var mainImg = vImgs.length > 0 ? vImgs[0] : (imgMap[String(r.id)] || '');
      var thumbImgs = vImgs.length > 1 ? vImgs.slice(1) : [];
      return {
        id: r.id, name: r.name, status: r.status, type: r.type, designer: r.designer,
        target_price: r.target_price,
        collection_name: r.collection_name, collection_id: r.collection_id,
        img_url: mainImg, thumb_images: thumbImgs,
      };
    });
  });
}

